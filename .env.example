# Copy to backend/.env and fill in real local values. Never commit backend/.env.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_management
DB_USER=postgres
DB_PASSWORD=changeme

# Backend server
BACKEND_PORT=3000
NODE_ENV=development

# CORS
FRONTEND_ORIGIN=http://localhost:4200

# Error-handling / debugging challenge (see README "Error Handling" section)
# When true, POST /employees randomly throws to simulate an intermittent failure.
SIMULATE_CREATE_FAILURES=false
